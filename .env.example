# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------
# Database — Neon Postgres (use the POOLED connection string)
# ---------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------
# Auth0 (@auth0/nextjs-auth0 v4)
# Dashboard → Applications → your app (type: Regular Web Application)
#
# Set these in the Auth0 application settings:
#   Allowed Callback URLs:      http://localhost:3000/auth/callback
#   Allowed Logout URLs:        http://localhost:3000
# ---------------------------------------------------------------

# Tenant domain WITHOUT a scheme — e.g. dev-abc123.us.auth0.com
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Session/transaction cookie encryption key, 32+ chars.
# Generate with: openssl rand -hex 32
AUTH0_SECRET=

APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------
# App URLs
# ---------------------------------------------------------------

# Absolute origin used to build Stripe Checkout return URLs. Must match the
# origin the browser is actually on, or Checkout returns to the wrong host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tenant subdomains are resolved against this in proxy.ts.
# Locally the proxy also accepts <slug>.localhost.
NEXT_PUBLIC_ROOT_DOMAIN=regroup.app

# ---------------------------------------------------------------
# Stripe (test mode)
# Run `npm run stripe:bootstrap` once to create the product catalog
# and the Customer Portal configuration.
# ---------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# This value is printed by the CLI and differs from the dashboard's.
STRIPE_WEBHOOK_SECRET=whsec_

# ---------------------------------------------------------------
# AI site copy generation
# ---------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------
# Cloudflare R2 — media uploads
# ---------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ---------------------------------------------------------------
# Upstash Redis — published-site caching
# ---------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

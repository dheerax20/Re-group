# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------
# Database — Neon Postgres (use the POOLED connection string)
# ---------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------
# Auth0 (@auth0/nextjs-auth0 v4)
# Dashboard → Applications → your app (type: Regular Web Application)
#
# Set these in the Auth0 application settings:
#   Allowed Callback URLs:      http://localhost:3000/auth/callback
#   Allowed Logout URLs:        http://localhost:3000
# ---------------------------------------------------------------

# Tenant domain WITHOUT a scheme — e.g. dev-abc123.us.auth0.com
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Session/transaction cookie encryption key, 32+ chars.
# Generate with: openssl rand -hex 32
AUTH0_SECRET=

APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------
# App URLs
# ---------------------------------------------------------------

# Absolute origin used to build Stripe Checkout return URLs. Must match the
# origin the browser is actually on, or Checkout returns to the wrong host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tenant subdomains are resolved against this in proxy.ts.
# Locally the proxy also accepts <slug>.localhost.
NEXT_PUBLIC_ROOT_DOMAIN=regroup.app

# ---------------------------------------------------------------
# Stripe (test mode)
# Run `npm run stripe:bootstrap` once to create the product catalog
# and the Customer Portal configuration.
# ---------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# This value is printed by the CLI and differs from the dashboard's.
STRIPE_WEBHOOK_SECRET=whsec_

# ---------------------------------------------------------------
# AI site generation — the church-website crew (lib/ai/agents)
#
# Default (nothing below set): every one of the 6 agents runs on
# gpt-4o-mini against OpenAI directly. Everything past OPENAI_API_KEY
# is optional and changes nothing until you set it.
# ---------------------------------------------------------------
OPENAI_API_KEY=

# Route every agent through OpenRouter instead of OpenAI directly — one
# key, many providers (Llama, Mistral, Gemini, Claude, ...), OpenAI-
# compatible so no extra package is needed. If set, OPENAI_API_KEY above
# is not used by the crew.
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-agent model override. Each defaults to "gpt-4o-mini" (or, under
# AI_PROVIDER=openrouter, must use OpenRouter's "vendor/model" naming —
# e.g. "meta-llama/llama-3.1-8b-instruct", "anthropic/claude-3.5-haiku").
# A common setup: keep the structural agents small/cheap and give only
# the copywriter — the one agent whose words a visitor actually reads —
# a stronger model.
# AI_MODEL_PRODUCER=
# AI_MODEL_THEME_DIRECTOR=
# AI_MODEL_LAYOUT_ARCHITECT=
# AI_MODEL_COPYWRITER=
# AI_MODEL_RESPONSIVE_QA=
# AI_MODEL_MEDIA_DIRECTOR=
# AI_MODEL_EDITOR=
# AI_MODEL_CHAT_CLASSIFIER=
# AI_MODEL_CHAT_ANSWER=

# Monthly caps, enforced in Postgres so a Redis flush can't reset them.
# Defaults shown. One "chat message" is one message a church sends the
# site chatbot, whether the reply was a plain answer or a site edit.
# AI_MONTHLY_BUILD_LIMIT=25
# AI_MONTHLY_PROMPT_LIMIT=150
# AI_MONTHLY_CHAT_LIMIT=300

# ---------------------------------------------------------------
# Slack — connecting a church's workspace to their site
# (lib/slack). Without these three, /dashboard/slack explains that
# Slack isn't switched on yet rather than failing at runtime.
#
# Create an app at api.slack.com/apps ("From scratch"):
#   OAuth & Permissions → Bot Token Scopes: add "commands", "chat:write"
#   OAuth & Permissions → Redirect URLs:
#     <NEXT_PUBLIC_APP_URL>/api/slack/oauth/callback
#   Basic Information → App Credentials: copy Client ID, Client Secret,
#     and Signing Secret below.
# ---------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Encrypts the Slack bot token before it is stored in Postgres — this is the
# first third-party credential this app keeps in its own database rather
# than only in env vars. Any string works as a source key (it is hashed to a
# fixed-length key internally); generate with: openssl rand -hex 32
SLACK_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------
# Cloudflare R2 — media uploads
# ---------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ---------------------------------------------------------------
# Upstash Redis — published-site caching
# ---------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------
# Custom domains (Vercel)
#
# Without VERCEL_API_TOKEN + VERCEL_PROJECT_ID the Domains screen
# explains that the feature is off rather than failing at runtime.
#
# Token: Vercel dashboard → Account Settings → Tokens. It needs
# access to the project (and the team, if the project is in one).
# ---------------------------------------------------------------
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# Only for team-owned projects.
VERCEL_TEAM_ID=

# Override only if Vercel assigned your project dedicated records.
# VERCEL_APEX_IP=76.76.21.21
# VERCEL_CNAME_TARGET=cname.vercel-dns.com

# ---------------------------------------------------------------
# Internal service calls
#
# proxy.ts cannot open a database connection, so on a cache miss it
# asks /api/internal/hostname to resolve a custom domain. This secret
# authenticates that call. Custom domains will not resolve without it.
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------
INTERNAL_API_SECRET=

# ---------------------------------------------------------------
# AI budget
#
# Monthly ceilings per site, enforced against Postgres so they cannot
# be bypassed by clearing a cache. Defaults are used when unset.
# ---------------------------------------------------------------
# AI_MONTHLY_BUILD_LIMIT=25
# AI_MONTHLY_PROMPT_LIMIT=150

# ---------------------------------------------------------------
# Seeding
#
# Set to 1 to have `npm run db:seed` also create the demo church.
# Never set this against a real database.
# ---------------------------------------------------------------
# SEED_DEMO_CHURCH=1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiteStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  LOGO
  FAVICON
  IMAGE
  VIDEO
  OTHER
}

model User {
  id      String  @id @default(cuid())
  auth0Id String  @unique
  email   String?
  name    String?
  picture String?

  // Set once the user has paid and dismissed /welcome. Distinct from
  // `site` — a user can have a plan before a site exists.
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site            Site?
  billingCustomer BillingCustomer?
  entitlements    Entitlement[]
  ghlAccount      GhlAccount?
}

enum GhlProvisionStatus {
  PENDING
  PROVISIONING
  ACTIVE
  FAILED
}

/**
 * The user's matching GoHighLevel sub-account (see `ghl.md`).
 * One per user, created when their subscription activates. `locationId` is
 * written the moment `POST /locations/` succeeds — BEFORE the user call — so a
 * retry after a half-failure reuses that Location instead of creating a second
 * one. Sub-accounts are billable on GHL's Agency Pro plan, so accidentally
 * creating two is a real cost, not just untidy data.
 * No GHL password is stored. `POST /users/` requires one, so a random value is
 * generated per user and discarded — SSO is the login path, and an unused
 * credential sitting in a table is a liability rather than a feature.
 */
model GhlAccount {
  id         String             @id @default(cuid())
  userId     String             @unique
  locationId String?
  ghlUserId  String?
  status     GhlProvisionStatus @default(PENDING)
  /// Last failure message, kept for support rather than shown to the user.
  error      String?
  attempts   Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ghl_accounts")
}

model Site {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  denomination     String?
  congregationSize Int?

  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?

  tagline     String?
  storyConfig Json    @default("{}")

  status SiteStatus @default(DRAFT)

  brandConfig      Json
  featureConfig    Json
  navigationConfig Json
  sectionConfig    Json
  /**
   * The AI-composed page as a generic block tree (`lib/site/blocks/types.ts`).
   * Deliberately a SEPARATE column from `sectionConfig` rather than reusing
   * it: many writers (the visual editor's `updateSections`, the AI chat
   * editor, `enableFeatureOnSite`) still read/write `sectionConfig` in the
   * legacy `SectionInstance[]` shape, and overloading one column with two
   * incompatible shapes let any of them silently destroy a composed page.
   * Null means "no block tree yet" — the read path then synthesizes one from
   * `sectionConfig` via `legacySectionsToBlocks`.
   */
  blockConfig      Json?
  seoConfig        Json

  templateId      String
  templateVersion Int    @default(1)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  pages           SitePage[]
  socialLinks     SocialLink[]
  media           Media[]
  sermons         Sermon[]
  events          Event[]
  registrations   Registration[]
  domains         SiteDomain[]
  generationJobs  SiteGenerationJob[]
  chatMessages    ChatMessage[]
  slackConnection SlackConnection?

  @@index([status])
}

enum DomainStatus {
  // Added to the Vercel project; DNS does not point here yet.
  PENDING_DNS
  // Vercel returned a TXT challenge because the domain is claimed by another
  // Vercel account. `verification` holds the record to add.
  PENDING_VERIFICATION
  // Verified by Vercel and DNS resolves correctly. Safe to serve.
  ACTIVE
}

/**
 * A custom hostname pointed at one site. Only ACTIVE rows are ever served —
 * `proxy.ts` resolves an incoming Host header to a site slug through here.
 * `hostname` is globally unique because a hostname can only ever route to one
 * site, and that uniqueness is what makes the resolver cache safe.
 */
/**
 * One editable public page of a church's site.
 * Secondary pages used to be hardcoded block trees written inline in their
 * route files (`app/sites/[siteSlug]/about/page.tsx` built its `BlockNode[]`
 * on every render), so there was nothing for the AI editor — or anything else
 * — to change. A row here is what makes a page editable.
 * The HOMEPAGE deliberately stays on `Site.blockConfig` rather than moving
 * here. That column has one writer, several readers, and the whole
 * `blockConfig ?? sectionConfig` legacy bridge hanging off it; relocating the
 * one path that already works, for symmetry, is not worth the regression risk.
 * `lib/site/blocks/resolve-page.ts` is the single place that asymmetry lives.
 * A missing row is not an error: the read path falls back to
 * `defaultPageBlocks()`, which is the same composition these pages have always
 * rendered. That is what lets every existing site keep working with no
 * backfill — a page only gains a row once something actually edits it.
 */
model SitePage {
  id     String @id @default(cuid())
  siteId String
  /// Matches an `href` in `SITE_PAGE_LINKS` (lib/site/pages.ts).
  path   String

  blockConfig Json
  /// Reserved for per-page title/description. Nothing writes it yet.
  seoConfig   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, path])
  @@index([siteId])
  @@map("site_pages")
}

model SiteDomain {
  id       String @id @default(cuid())
  siteId   String
  hostname String @unique

  status DomainStatus @default(PENDING_DNS)

  // The one hostname used to build canonical/OG URLs. At most one per site,
  // enforced in the action layer rather than the schema, because "no primary"
  // is a legal state while every domain is still pending.
  isPrimary Boolean @default(false)

  // Whether Vercel considers the DNS records wrong. Distinct from `status`:
  // a domain can be verified and still misconfigured if an A record is stale.
  misconfigured Boolean @default(true)

  // TXT challenges from Vercel, shape: [{ type, domain, value, reason }].
  verification Json @default("[]")

  lastCheckedAt DateTime?
  verifiedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([status])
  @@map("site_domains")
}

enum GenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/**
 * One AI website build or editor prompt, tracked so the work survives the
 * request that started it.
 * The crew is six sequential LLM calls; running it inside the request that the
 * browser is waiting on meant a closed tab discarded finished work and the
 * progress UI could only ever be a guess. The action enqueues a row, `after()`
 * advances it, and the client polls this.
 * It doubles as the usage ledger: the monthly cap counts rows, so the limit
 * cannot be bypassed by clearing a cache.
 */
model SiteGenerationJob {
  id     String @id @default(cuid())
  siteId String

  // "full_build" (the agent crew) | "editor_prompt" (freeform edit)
  kind   String
  status GenerationStatus @default(QUEUED)

  // Which specialist is running, and where it sits in the run. Written as the
  // crew advances, so the client's progress display reflects real state.
  step       String?
  stepIndex  Int     @default(0)
  totalSteps Int     @default(6)

  /**
   * The Trigger.dev run this job is executing as. Set immediately after
   * `tasks.trigger()`, and what lets a client that reloaded mid-build
   * re-subscribe to the live run instead of falling back to polling.
   */
  triggerRunId String?

  prompt    String?
  error     String?
  styleName String?
  summary   String?
  log       Json    @default("[]")

  /// Which surface started this job: "web" | "slack". Defaults to "web",
  /// which is correct for every row that existed before Slack could edit.
  source String @default("web")

  /// Where the reply lives, when this job came from Slack.
  slackChannelId String?
  /// OUR message's `ts` — what `chat.update` targets as the job progresses.
  /// Never the church member's message; we only ever edit our own.
  slackMessageTs String?
  /// The Slack user who ran the command, for the audit trail.
  slackUserId    String?

  /**
   * The undo snapshot: this page's tree as it was immediately BEFORE this job
   * wrote to it. Written inside the same transaction as the page write, so it
   * exists if and only if a write actually happened — a snapshot taken before
   * the provider call would leave a phantom undo point behind every failed
   * prompt.
   */
  previousPath   String?
  previousBlocks Json?

  /**
   * Whether a `SitePage` row existed for `previousPath` before this edit.
   * The subtle one. A never-edited secondary page has NO row — `getPageBlocks`
   * recomputes its default from the site's brand and features on every render.
   * The edit creates the row. If undo merely wrote the old tree back, the page
   * would stay frozen at whatever that default happened to be. False here
   * tells undo to DELETE the row instead, returning the page to recomputing.
   */
  previousPageExisted Boolean?

  /// The three sidecar keys of `storyConfig` this job overwrote
  /// (improvements / designFeedback / mobileFeedback), never the whole column.
  previousStory Json?

  /// sha256 of the tree as this job wrote it. A mismatch at undo time means
  /// the site changed afterwards — undo still wins, but says what it discarded.
  writtenBlocksHash String?

  revertedAt     DateTime?
  /// What undo threw away. Insurance only; there is no redo.
  revertedBlocks Json?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([status])
  @@map("site_generation_jobs")
}

enum ChatRole {
  USER
  ASSISTANT
}

/**
 * One growing conversation per site — not a list of named threads, since
 * nothing in the product needs more than one ongoing chat with a site's
 * editor agent. `appliedSummary` is set only on an ASSISTANT message that
 * actually changed the live site, which is what lets the chat UI show
 * "Applied" on some replies and a plain answer on others, and doubles as
 * the audit trail for what changed and when.
 */
model ChatMessage {
  id             String   @id @default(cuid())
  siteId         String
  role           ChatRole
  content        String
  appliedSummary String?
  createdAt      DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@map("chat_messages")
}

/**
 * One Slack workspace connected to one site — both directions unique,
 * matching `Site.userId`'s "one of these per that" shape elsewhere in this
 * schema. A church that reinstalls into the same Slack workspace should
 * reconnect to the same row, not accumulate a second one.
 * `botAccessToken` is encrypted before it ever reaches this table
 * (`lib/slack/crypto.ts`) — it is a live bearer credential for posting into
 * the church's Slack as the bot, the first third-party secret this app
 * stores in Postgres rather than only in its own env vars, and is treated
 * with the same care as one.
 */
model SlackConnection {
  id     String @id @default(cuid())
  siteId String @unique

  slackTeamId   String @unique
  slackTeamName String
  botUserId     String

  botAccessToken String

  installedByUserId String

  /**
   * The single channel `/regroup` answers in, captured from
   * `incoming_webhook.channel_id` during the install.
   * NULLABLE on purpose. Connections made before the channel picker existed
   * have none, and a backfill cannot invent one — nobody chose a channel. A
   * null here means "pre-alpha connection": every command is refused with
   * "reconnect Slack and pick a channel" rather than defaulting to somewhere
   * the church did not ask for.
   */
  channelId   String?
  /// `incoming_webhook.channel`, e.g. "#website". Display only, never matched on.
  channelName String?

  /**
   * `authed_user.id` — the ONE Slack identity permitted to edit this site.
   * Slack identity is not proof of Regroup identity, so this is a binding
   * made at install time by someone already holding the Regroup session,
   * not an email match. Null for the same reason `channelId` can be.
   */
  ownerSlackUserId String?

  /// Bot scopes actually granted, so an install missing one is diagnosable
  /// from the row instead of from a failed API call in production.
  scopes String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("slack_connections")
}

model SocialLink {
  id        String   @id @default(cuid())
  siteId    String
  platform  String
  url       String
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Media {
  id        String    @id @default(cuid())
  siteId    String
  type      MediaType
  url       String
  altText   String?
  filename  String?
  createdAt DateTime  @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Sermon {
  id           String   @id @default(cuid())
  siteId       String
  title        String
  slug         String
  description  String?
  speaker      String?
  series       String?
  date         DateTime
  videoUrl     String?
  audioUrl     String?
  thumbnailUrl String?
  transcript   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
  @@index([siteId, date])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_CLOSED
  COMPLETED
  CANCELLED
}

model Event {
  id              String      @id @default(cuid())
  siteId          String
  title           String
  slug            String
  description     String?
  startAt         DateTime
  endAt           DateTime?
  location        String?
  imageUrl        String?
  registrationUrl String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  status               EventStatus @default(DRAFT)
  category             String?
  organizer            String?
  address              String?
  capacity             Int?
  registrationDeadline DateTime?
  rsvpEnabled          Boolean     @default(false)
  allowGuests          Boolean     @default(false)
  allowWaitlist        Boolean     @default(false)

  site          Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@unique([siteId, slug])
  @@index([siteId, startAt])
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

model Registration {
  id            String             @id @default(cuid())
  eventId       String
  siteId        String
  status        RegistrationStatus @default(CONFIRMED)
  attendeeName  String
  attendeeEmail String
  attendeePhone String?
  guestCount    Int                @default(0)
  dietaryNotes  String?
  prayerRequest String?
  qrToken       String             @unique
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  site  Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([siteId])
}

model Template {
  id          String   @id
  name        String
  description String?
  category    String?
  version     Int      @default(1)
  metadata    Json
  createdAt   DateTime @default(now())
}

// ============================================================
// BILLING MODULE
// Nothing here reads the user model directly — it only depends on a
// `userId: String`, which is why swapping the temp auth shim for Auth0
// touched only the two `user` relations below.
// ============================================================

model BillingCustomer {
  id               String @id @default(cuid())
  userId           String @unique
  stripeCustomerId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@map("billing_customers")
}

enum SubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

model Subscription {
  id                   String @id @default(cuid())
  billingCustomerId    String
  stripeSubscriptionId String @unique

  status            SubscriptionStatus
  cancelAtPeriodEnd Boolean            @default(false)

  // NOTE: Stripe has no subscription-level period since Basil.
  // These are DERIVED from the base plan item and stored for convenient
  // querying only. items[].currentPeriodEnd is the authoritative value.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  // Watermark of the newest Stripe EVENT applied, from the event's `created`
  // timestamp — i.e. Stripe's clock. Only webhook-driven syncs advance it.
  lastEventAt DateTime?

  // When the state currently stored here was read from Stripe — i.e. the LOCAL
  // clock. Reconcile syncs have no event timestamp, so they compare against
  // this instead. Keeping the two watermarks separate means each comparison is
  // same-clock; mixing them left a residual race and made clock skew matter.
  stateReadAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingCustomer BillingCustomer    @relation(fields: [billingCustomerId], references: [id], onDelete: Cascade)
  items           SubscriptionItem[]

  @@index([billingCustomerId])
  @@map("subscriptions")
}

model SubscriptionItem {
  id                       String  @id @default(cuid())
  subscriptionId           String
  stripeSubscriptionItemId String  @unique
  stripePriceId            String
  // The Stripe lookup_key AS OF THE LAST SYNC. Informational only — a
  // lookup key is mutable (transfer_lookup_key moves it to a new price),
  // so it must never be used to decide what a subscription grants.
  lookupKey                String
  // Stable plan identity: "base" | an AddonKey. Resolved from immutable
  // price metadata written at catalog bootstrap. THIS is what feature
  // gating and add-on matching read.
  planKey                  String?
  quantity                 Int     @default(1)

  // Authoritative billing period — lives on the ITEM in Stripe, not the sub.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_items")
}

// Denormalized read model. This is what the app gates features on —
// never query Stripe or Subscription/SubscriptionItem from UI code.
// @@unique([userId, featureKey]) requires every product to grant a
// DISTINCT feature key, or the second upsert collides.
model Entitlement {
  id         String    @id @default(cuid())
  userId     String
  featureKey String
  source     String // "base" | "addon_website" | "addon_automations"
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureKey])
  @@index([userId])
  @@map("entitlements")
}

// Webhook idempotency. Stripe retries; handlers must be safe to re-run.
model ProcessedStripeEvent {
  id          String    @id // the Stripe event id, evt_...
  type        String
  // When the row was INSERTed, i.e. when a handler claimed the event.
  processedAt DateTime  @default(now())
  // Set only once the handler has finished successfully. A row with a null
  // completedAt is a claim whose handler never reported back — a crash
  // between claim and completion. Such claims are reprocessable so the
  // event is not silently lost.
  completedAt DateTime?

  @@index([processedAt])
  @@map("processed_stripe_events")
}
